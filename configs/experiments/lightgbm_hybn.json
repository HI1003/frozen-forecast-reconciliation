    "inner_early_stopping": false,
    "selection": "dataset_equal_mean_18_cell_validation_L1_over_unreconciled_base; ties fewer_trees_then_fewer_leaves",
    "final_refits": 0,
    "selected_weight_policy": "reuse_frozen_train_only_search_models",
